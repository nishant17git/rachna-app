<?xml version='1.0' encoding='utf-8'?>
<widget id="com.rachna.app" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>Rachna</name>
    <description>Rachna Application</description>
    <author email="nishant17github@gmail.com">Nishant</author>
    <content src="https://rachnabymolecules.vercel.app" />
    
    <!-- Network & Navigation Permissions -->
    <access origin="*" />
    <allow-navigation href="https://rachnabymolecules.vercel.app*" />
    <allow-navigation href="https://*.vercel.app*" />
    <allow-navigation href="https://*.supabase.co*" />

    <!-- Performance, Persistence & Device Identity -->
    <preference name="loadUrlTimeoutValue" value="70000" />
    <preference name="Orientation" value="portrait" />
    <preference name="KeepRunning" value="true" />
    <preference name="AppendUserAgent" value="RachnaNativeApp/1.0 (Android)" />
    <preference name="AllowBackForwardNavigationGestures" value="true" />
    <preference name="EnableViewportScale" value="false" />

    <platform name="android">
        <!-- Native UI Physics & GPU Acceleration -->
        <preference name="android-hardwareAccelerated" value="true" />
        <preference name="DisallowOverscroll" value="false" />
        <preference name="FontSize" value="100%" />
        <preference name="AndroidXSoftInputMode" value="adjustResize" />
        <preference name="MixedContentMode" value="0" />

        <!-- Status Bar Configuration -->
        <preference name="StatusBarOverlaysWebView" value="false" />
        <preference name="StatusBarBackgroundColor" value="#11100C" />
        <preference name="StatusBarStyle" value="lightcontent" />

        <!-- Navigation Bar Styling -->
        <preference name="NavigationBarBackgroundColor" value="#11100C" />
        <preference name="NavigationBarLight" value="false" />

        <!-- Splash Screen Transition & Styling -->
        <icon src="res/icon.png" />
        <splash src="res/splash.png" />
        <preference name="SplashScreenDelay" value="2000" />
        <preference name="AutoHideSplashScreen" value="true" />
        <preference name="FadeSplashScreen" value="true" />
        <preference name="FadeSplashScreenDuration" value="350" />
        <preference name="AndroidWindowSplashScreenBackground" value="#11100C" />
        <preference name="AndroidWindowSplashScreenAnimatedIcon" value="res/splash.png" />

        <!-- Copy Shortcut Resources to Android Build -->
        <resource-file src="res/values/shortcuts_strings.xml" target="app/src/main/res/values/shortcuts_strings.xml" />
        <resource-file src="res/xml/shortcuts.xml" target="app/src/main/res/xml/shortcuts.xml" />

        <!-- Android App Links & Shortcuts Metadata -->
        <config-file target="AndroidManifest.xml" parent="/manifest/application/activity">
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="rachnabymolecules.vercel.app" />
            </intent-filter>
        </config-file>
    </platform>
</widget>
